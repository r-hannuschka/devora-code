{
  "name": "devora-code",
  "publisher": "trueffelmafia",
  "displayName": "Devora Code Core",
  "engines": {
    "vscode": "^1.105.0"
  },
  "version": "0.0.4",
  "description": "Seamless time tracking and issue management directly inside VS Code.",
  "categories": [
    "Visualization",
    "Other"
  ],
  "private": "true",
  "tags": [
    "jira",
    "github",
    "issues"
  ],
  "license": "MIT",
  "author": "Ralf Hannuschka",
  "repository": {
    "type": "git",
    "url": "https://github.com/r-hannuschka/devora-code"
  },
  "bugs": {
    "url": "https://github.com/r-hannuschka/devora-code/issues"
  },
  "homepage": "https://github.com/r-hannuschka/devora-code",
  "type": "commonjs",
  "main": "./dist/devora-code.js",
  "activationEvents": [
    "workspaceContains:**/*.devora-timesheet"
  ],
  "contributes": {
    "commands": [
      {
        "command": "devora-code.openWebview",
        "title": "open devora code dashboard",
        "category": "Devora Code"
      },
      {
        "command": "devora-code.activated",
        "title": "Devora Code Core Activated Trigger"
      },
      {
        "command": "devora-code.timesheet-sync-raw",
        "title": "Timesheet mit DevoraCode Synchronisieren",
        "category": "Devora Code"
      },
      {
        "command": "devora-code.create-backup",
        "title": "Create backup for all timesheets",
        "category": "Devora Code"
      },
      {
        "command": "devora-code.restore-backup",
        "title": "restore backup from file",
        "category": "Devora Code"
      },
      {
        "command": "devora-code.close-open-timers",
        "title": "Closes open timers and sanitzes timesheets",
        "category": "Devora Code"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "devora-code.activated",
          "when": "false"
        },
        {
          "command": "devora-code.timesheet-sync-raw",
          "when": "resourceExtname == .devora-timesheet"
        }
      ],
      "editor/title": [
        {
          "command": "devora-code.timesheet-sync-raw",
          "group": "navigation@1",
          "when": "resourceExtname == .devora-timesheet"
        }
      ]
    },
    "languages": [
      {
        "id": "json",
        "aliases": [
          "Devora Timesheet"
        ],
        "extensions": [
          ".devora-timesheet"
        ]
      }
    ],
    "configuration": {
      "properties": {
        "devora-code.projectName": {
          "type": "string",
          "default": "",
          "description": "Name des aktuellen Projekts.",
          "scope": "resource"
        },
        "devora-code.timesheeStorageDir": {
          "type": "string",
          "default": "./.devora-code/timesheets",
          "description": "Speicherort der Timesheets",
          "scope": "resource"
        },
        "devora-code.backupStorageDir": {
          "type": "string",
          "default": "./.devora-code/backup",
          "description": "Speicherort der Backups",
          "scope": "resource"
        }
      }
    }
  },
  "dependencies": {
    "@devora-code/sdk": "*",
    "adm-zip": "0.6.1",
    "date-fns": "4.4.0"
  },
  "scripts": {
    "build": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite build --emptyOutDir true --sourcemap false",
    "package": "npx @vscode/vsce package --no-dependencies --out ../dist/",
    "watch": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite build --watch",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.4"
  }
}
