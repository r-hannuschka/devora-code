{
  "name": "devora-code-jira",
  "publisher": "trueffelmafia",
  "displayName": "Devora Code Jira API",
  "engines": {
    "vscode": "^1.105.0"
  },
  "version": "0.0.4",
  "extensionDependencies": [
    "trueffelmafia.devora-code"
  ],
  "description": "Jira Devora Code Integration",
  "license": "MIT",
  "author": "",
  "type": "commonjs",
  "main": "./dist/devora-code-jira.js",
  "activationEvents": [
    "onCommand:devora-code.activated"
  ],
  "contributes": {
    "commands": [],
    "configuration": {
      "properties": {
        "devora-code.jira.apiUrl": {
          "type": "string",
          "default": "",
          "description": "Jira Restapi URL",
          "scope": "resource"
        },
        "devora-code.jira.apiToken": {
          "type": "string",
          "default": "",
          "description": "Jira API Token",
          "scope": "resource"
        },
        "devora-code.jira.userName": {
          "type": "string",
          "default": "",
          "description": "Jira Benutzername/Email",
          "scope": "resource"
        },
        "devora-code.jira.projectKey": {
          "type": "string",
          "default": "",
          "description": "Jira Project Key",
          "scope": "resource"
        },
        "devora-code.jira.issueTypeMapping": {
          "type": "object",
          "title": "Ticket-Typen Mapping",
          "description": "Füge den Namen aus deinem Jira hinzu (Links) und wähle den internen Typ (Rechts).",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "BUG",
              "FEATURE"
            ]
          },
          "default": {},
          "scope": "resource"
        },
        "devora-code.jira.statusMapping": {
          "type": "object",
          "title": "Status Mapping",
          "description": "Füge den Status-Namen aus deinem Jira hinzu (Links) und wähle den internen Zustand (Rechts).",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "TO_DO",
              "IN_PROGRESS",
              "TEST",
              "DONE"
            ]
          },
          "default": {},
          "scope": "resource"
        }
      }
    }
  },
  "enabledApiProposals": [
    "extensionRuntime"
  ],
  "scripts": {
    "build": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite build --emptyOutDir true --sourcemap false",
    "watch": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite build --watch",
    "test": "echo \"Error: no test specified\" && exit 1",
    "package": "npx @vscode/vsce package --no-dependencies --out ../dist/"
  },
  "dependencies": {
    "@devora-code/sdk": "*",
    "@devora-code/api": "*",
    "axios": "1.20.0"
  }
}
