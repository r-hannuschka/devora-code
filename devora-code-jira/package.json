{
  "name": "devora-code-jira",
  "publisher": "trueffelmafia",
  "displayName": "Devora Code Jira API",
  "engines": {
    "vscode": "^1.105.0"
  },
  "version": "0.0.0",
  "extensionDependencies": [
    "trueffelmafia.devora-code"
  ],
  "description": "Jira Devora Code Integration",
  "license": "MIT",
  "author": "",
  "type": "commonjs",
  "main": "./dist/devora-code-jira.js",
  "activationEvents": [
    "onCommand:devora-code.activated"
  ],
  "contributes": {
    "commands": [],
    "configuration": {
      "properties": {
        "workpulse-jira.JIRA_API_URL": {
          "type": "string",
          "default": "",
          "description": "Jira Restapi URL"
        },
        "workpulse-jira.JIRA_API_TOKEN": {
          "type": "string",
          "default": "",
          "description": "Jira API Token"
        },
        "workpulse-jira.JIRA_USER_NAME": {
          "type": "string",
          "default": "",
          "description": "Jira Benutzername/Email"
        },
        "workpulse-jira.JIRA_PROJECT_KEY": {
          "type": "string",
          "default": "",
          "description": "Jira Project Key"
        },
        "workpulse-jira.ISSUE_TYPE_MAPPING": {
          "type": "object",
          "title": "Ticket-Typen Mapping",
          "description": "Füge den Namen aus deinem Jira hinzu (Links) und wähle den internen Typ (Rechts).",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "BUG",
              "FEATURE"
            ]
          },
          "default": {}
        },
        "workpulse-jira.STATUS_MAPPING": {
          "type": "object",
          "title": "Status Mapping",
          "description": "Füge den Status-Namen aus deinem Jira hinzu (Links) und wähle den internen Zustand (Rechts).",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "TO_DO",
              "IN_PROGRESS",
              "TEST",
              "DONE"
            ]
          },
          "default": {}
        }
      }
    }
  },
  "enabledApiProposals": [
    "extensionRuntime"
  ],
  "scripts": {
    "build": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite build",
    "watch": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite build --watch",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@devora-code/sdk": "*",
    "@devora-code/api": "*",
    "axios": "1.20.0"
  }
}
