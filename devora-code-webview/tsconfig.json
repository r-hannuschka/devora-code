{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@/core/*": ["./src/core/*/index.ts"],
      "@/common/components/*": ["./src/common/components/*/index.ts"],
      "@/common/*": ["./src/common/*/index.ts"],
      "@/common": ["./src/common/index.ts"],
      "@/util/*": ["./src/utils/*/index.ts"],
      // deprecated use @/domain for better scale
      "@/feature/*/data-access": ["./src/features/*/data-access/index.ts"],
      "@/feature/*/feature-shell": ["./src/features/*/feature-shell/index.ts"],
      "@/feature/*/feature-shell/widgets": ["./src/features/*/feature-shell/widgets/index.ts"],

      "@/domain/*/widgets": ["./src/domains/*/widgets/index.ts"],
      "@/domain/*": ["./src/domains/*/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
